# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Connection (SQLite local development default)
DATABASE_URL=sqlite:///./vyapar_brain.db

# Cryptographic Secret for Session Signatures (Replace with a 32+ char random string in production)
SECRET_KEY=replace_with_a_secure_random_value_in_production

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Sarvam AI Integration (Leave empty to use deterministic mock responses)
SARVAM_API_KEY=
SARVAM_ENABLED=false
